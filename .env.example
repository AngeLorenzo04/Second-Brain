# ==============================================================================
# SECOND BRAIN - ENVIRONMENT VARIABLES TEMPLATE
# Rinomina questo file in .env e compila con i tuoi valori reali
# ==============================================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_numeric_user_id_here

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Moodle University Calendar URL (iCal Feed)
MOODLE_CALENDAR=https://moodle.your-university.edu/calendar/export_execute.php?userid=...&authtoken=...

# Google Calendar OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Notion Integration API Key
notion_api_key=ntn_your_notion_integration_api_key_here

# Notion Database IDs (Metodo PARA)
INBOX_DB_ID=your_inbox_database_id_here
TASKS_DB_ID=your_tasks_database_id_here
PROJECTS_DB_ID=your_projects_database_id_here
AREAS_DB_ID=your_areas_database_id_here
RESOURCES_DB_ID=your_resources_database_id_here

# Optional: Google Cloud VPS Configuration (per il microkernel ./brain.sh)
VPS_USER=your_gcp_username
VPS_IP=your_gcp_vm_ip_address
VPS_SSH_KEY=~/.ssh/gcp_vps
